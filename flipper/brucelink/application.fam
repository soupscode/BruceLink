App(
    appid="brucelink",
    name="BruceLink",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="brucelink_app",
    # 8 KB: the X25519 handshake keeps ~1.4 KB of field elements on the
    # stack and runs under the GUI dispatcher frames; 4 KB overflowed
    # (BusFault on Connect, first hardware run 2026-11-23).
    stack_size=8 * 1024,
    fap_category="Bluetooth",
    fap_version="0.2",
    fap_description="Native remote for a StickS3 running Bruce (authenticated BLE bridge).",
    fap_author="BruceLink contributors",
    # fbt globs each entry recursively, so one pattern gathers the app
    # sources plus core/*.c: generated one-line wrappers that #include the
    # shared protocol core (../../shared/brucelink_core/src), so the device
    # and the host build identical protocol code. No symlinks (they break on
    # Windows checkouts). Regenerate with tools/gen_wrappers.py.
    sources=["*.c"],
)
